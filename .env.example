# Local MCP process connects directly to a Frappe site.
MCP_BACKEND=direct
MCP_FRAPPE_SITE=your-site.localhost
MCP_TRANSPORT=stdio
# Defaults to sales to preserve the existing MCP inventory. Set purchase for a
# separate Purchase MCP process using the same installed app.
MCP_PROFILE=sales

# Final-write approval policy. The security default is trusted_human, which
# requires an independently verified human approval signal. Use agent_delegated
# only for a trusted conversational client that confirms after explicit user approval.
MCP_APPROVAL_MODE=agent_delegated

# Stdio development/testing user only. HTTP never uses this as a fallback.
MCP_FRAPPE_USER=mcp.bhai@example.com

# Streamable HTTP bridge. Keep the secret outside this repository.
# MCP_TRANSPORT=streamable-http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8765
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_SHARED_SECRET=<minimum-32-character-secret>
# MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765,host.docker.internal:8765
# HTTP identity requires Authorization: Bearer <secret> and
# X-MCP-User-Email: <verified-user-email> on every request.

# Phase 2: local MCP process calls ERPNext over HTTPS instead.
# MCP_BACKEND=rest
# ERPNEXT_BASE_URL=https://erp.example.com
# ERPNEXT_API_KEY=replace-with-key
# ERPNEXT_API_SECRET=replace-with-secret
