# Local MCP process connects directly to a Frappe site.
MCP_BACKEND=direct
MCP_FRAPPE_SITE=your-site.localhost
MCP_TRANSPORT=streamable-http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PATH=/mcp
MCP_HTTP_PORT=8765
# HTTP only. Missing also means trusted_header for backward compatibility.
MCP_HTTP_AUTH_MODE=trusted_header
MCP_HTTP_SHARED_SECRET=<minimum-32-character-secret>
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765,127.0.0.1:8766,localhost:8766,host.docker.internal:8765,host.docker.internal:8766

# Set per process in the startup command: sales or purchase.
# MCP_PROFILE=sales

# Final-write approval policy. The default is agent_delegated: the trusted
# conversational client confirms only after explicit user approval. Set this to
# trusted_human explicitly when an independently verified human approval signal is required.
MCP_APPROVAL_MODE=agent_delegated

# Used only when running the stdio transport. HTTP requests provide the user
# through the X-MCP-User-Email header instead.
MCP_FRAPPE_USER=mcp.bhai@example.com

# HTTP identity requires Authorization: Bearer <secret> and
# X-MCP-User-Email: <verified-user-email> on every request.

# OAuth Streamable HTTP alternative. When MCP_HTTP_AUTH_MODE=oauth, omit the
# shared secret and email header; use a migrated, resource-bound Frappe OAuth
# Client and the native token owner becomes the ERPNext execution user.
# MCP_HTTP_AUTH_MODE=oauth
# MCP_OAUTH_ISSUER_URL=https://erp.example.com
# MCP_OAUTH_RESOURCE_SERVER_URL=https://mcp.example.com/mcp
# MCP_OAUTH_REQUIRED_SCOPES=mcp:access
# MCP_OAUTH_FRAPPE_CLIENT_ID=replace-with-bound-oauth-client-id

# Remote ERPNext bridge. The remote site must have this compatible mcp_erpnext
# app installed. REST executes as the user that owns this API key/secret.
# REST currently supports the stdio MCP transport only.
# MCP_BACKEND=rest
# MCP_TRANSPORT=stdio
# ERPNEXT_BASE_URL=https://erp.example.com
# ERPNEXT_API_KEY=replace-with-key
# ERPNEXT_API_SECRET=replace-with-secret

# Local development only: allow plain HTTP exclusively for a loopback origin,
# such as http://yob.localhost:8000. Never enable this for LAN/staging/live.
# MCP_REST_ALLOW_INSECURE_HTTP=1
