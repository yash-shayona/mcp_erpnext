# Local MCP process connects directly to a Frappe site.
MCP_BACKEND=direct
MCP_FRAPPE_SITE=your-site.localhost
MCP_TRANSPORT=stdio

# Existing service-user mode (the default when MCP_IDENTITY_MODE is absent).
MCP_IDENTITY_MODE=service
MCP_FRAPPE_USER=mcp.bhai@example.com

# LibreChat mode. The LibreChat STDIO configuration supplies these values.
# MCP_IDENTITY_MODE=librechat
# MCP_LIBRECHAT_USER_ID=<provided dynamically by LibreChat>
# MCP_LIBRECHAT_USER_EMAIL=<reference only>

# Streamable HTTP LibreChat bridge. Keep the secret outside this repository.
# MCP_TRANSPORT=streamable-http
# MCP_IDENTITY_MODE=librechat
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8765
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_SHARED_SECRET=<minimum-32-character-secret>
# MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765,host.docker.internal:8765
# HTTP identity comes only from each authenticated request header. Do not set
# MCP_LIBRECHAT_USER_ID when using this transport.

# Phase 2: local MCP process calls ERPNext over HTTPS instead.
# MCP_BACKEND=rest
# ERPNEXT_BASE_URL=https://erp.example.com
# ERPNEXT_API_KEY=replace-with-key
# ERPNEXT_API_SECRET=replace-with-secret
