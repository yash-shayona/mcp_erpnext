    {
      "name": "99 - Confirm Write - MANUAL / TEST SITE ONLY",
      "description": "Disabled by design. Never run from a collection runner. Requires explicit authorization, a same-process prepared token, and a development/test site.",
      "item": [
        {
          "name": "WRITE disabled - confirm quotation",
          "request": {
            "method": "POST",
