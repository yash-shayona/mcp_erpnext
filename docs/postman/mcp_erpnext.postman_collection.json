{
  "info": {
    "_postman_id": "mcp-erpnext-http-testing",
    "name": "mcp_erpnext Streamable HTTP (safe examples)",
    "description": "Manual MCP JSON-RPC requests for the current mcp_erpnext Streamable HTTP server. The final write request is disabled and manual-only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - MCP Protocol / Discovery",
      "item": [
        {
          "name": "Initialize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{shared_secret}}"
              },
              {
                "key": "X-MCP-User-Email",
                "value": "{{verified_user_email}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"{{protocol_version}}\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"postman\",\n      \"version\": \"1.0\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{mcp_url}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Initialize returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const sessionId = pm.response.headers.get('mcp-session-id');",
                  "if (sessionId) pm.environment.set('mcp_session_id', sessionId);",
                  "const dataLine = pm.response.text().split(/\\r?\\n/).find(line => line.startsWith('data: '));",
                  "if (dataLine) {",
                  "  const message = JSON.parse(dataLine.slice(6));",
                  "  pm.test('Initialize returns a JSON-RPC result', function () { pm.expect(message.result).to.exist; });",
                  "  if (message.result && message.result.protocolVersion) pm.environment.set('protocol_version', String(message.result.protocolVersion));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Initialized notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{shared_secret}}"
              },
              {
                "key": "X-MCP-User-Email",
                "value": "{{verified_user_email}}"
              },
              {
                "key": "mcp-session-id",
                "value": "{{mcp_session_id}}"
              },
              {
                "key": "mcp-protocol-version",
                "value": "{{protocol_version}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"notifications/initialized\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{mcp_url}}"
          }
        },
        {
          "name": "List tools",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{shared_secret}}"
              },
              {
                "key": "X-MCP-User-Email",
                "value": "{{verified_user_email}}"
              },
              {
                "key": "mcp-session-id",
                "value": "{{mcp_session_id}}"
              },
              {
                "key": "mcp-protocol-version",
                "value": "{{protocol_version}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\",\n  \"params\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{mcp_url}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('tools/list returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const dataLine = pm.response.text().split(/\\r?\\n/).find(line => line.startsWith('data: '));",
                  "if (dataLine) { const message = JSON.parse(dataLine.slice(6)); pm.test('tools/list returns tools', function () { pm.expect(message.result.tools).to.be.an('array'); }); }"
                ]
              }
            }
          ]
        }
      ]
